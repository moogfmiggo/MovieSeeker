# TMDB API (server-side only — never expose in client code)
TMDB_ACCESS_TOKEN=

# Supabase (server-side only — never expose in client code, never use
# NEXT_PUBLIC_ prefix for these). Used by lib/semantic/supabase-store.ts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Private connection from the deployed Next.js server to the RTX AI Server.
# Keep the token server-side; never use a NEXT_PUBLIC_ prefix.
MOVIESEEKER_AI_SERVER_URL=
MOVIESEEKER_AI_SERVER_TOKEN=
MOVIESEEKER_AI_TIMEOUT_MS=8000

# RTX server process (npm run ai:server). The same secret must be used for
# MOVIESEEKER_AI_TOKEN on the RTX machine and MOVIESEEKER_AI_SERVER_TOKEN on Vercel.
MOVIESEEKER_AI_TOKEN=
MOVIESEEKER_AI_HOST=127.0.0.1
MOVIESEEKER_AI_PORT=4317
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
WIKIPEDIA_TIMEOUT_MS=1500
